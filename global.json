{
  "sdk": {
    // Floor, not a pin: exact NuGet versions are declared in the csprojs, so the
    // SDK is allowed to float within 10.0.x (patch + feature bands). Deterministic
    // AOT output is explicitly not a goal; setup-dotnet honours this version floor
    // over its `10.0.x` input.
    "version": "10.0.400",
    "rollForward": "latestFeature"
  },
  "test": {
    "runner": "Microsoft.Testing.Platform"
  }
}
