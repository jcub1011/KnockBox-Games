<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0128e03a-678d-4724-8fcd-5802f2a124f7</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- The Dockerfile builds from the repo root (web/ must be in the build context). -->
    <DockerfileContext>..\</DockerfileContext>
    <RootNamespace>KnockBox.Server</RootNamespace>
    <AssemblyName>KnockBox.Server</AssemblyName>
    <PublishAot>True</PublishAot>
    <!-- GC: keep Server GC (best throughput for the WebSocket relay), but rein in its footprint.
         Server GC allocates a heap per logical CPU and retains memory aggressively, which on a
         many-core host makes RSS "climb high and stay" as server-authority Jint engines come and go.
         ConserveMemory (0-9) trades a little CPU to release/decommit sooner; HeapCount caps the
         per-core heap multiplication. These are embedded in runtimeconfig at publish and honored
         under Native AOT. Starting values — tune with KnockBox:MemoryLogSeconds diagnostics.
         NOTE: the equivalent env vars differ in encoding (DOTNET_GCHeapCount is HEX); the Dockerfile
         documents that foot-gun. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Serilog core emits an IL2104 trim roll-up for its reflective object-destructuring path. We only
         log scalar structured properties (ids, names, counts) and never @-destructure objects, so that
         path is never executed under AOT. The real risk — Serilog.Settings.Configuration's assembly
         scanning — is removed (levels are configured in code, see Program.cs). All first-party code and
         other dependencies analyze clean, so this is the only suppressed warning; revisit if new
         non-AOT-clean dependencies are added.

         IL2026/IL3053 are Jint's. Rooting Jint (TrimmerRootAssembly below) makes ILC analyze the whole
         assembly and report its internal RequiresUnreferencedCode sites per-site; per-assembly collapse
         (TrimmerSingleWarn / ilc singlewarnassembly) does not apply to rooted assemblies, so the codes
         are suppressed here — the design's decided fallback (SERVER_AUTHORITY_DESIGN.md §14.1). All
         four flagged 4.11.0 sites are unreachable from our usage (re-audit on Jint upgrade):
           - Options.Apply → NamespaceReference (×2): CLR namespace loading; only runs under AllowClr,
             which is never enabled.
           - DefaultTypeConverter.BuildDelegate: expression-tree marshaling for typed .NET delegates
             passed into the engine; we pass only ClrFunction/JsValue, never typed delegates.
           - DefaultObjectConverter.ConvertSystemTextJsonValue: JsonNode → JsValue conversion; our
             boundary is JSON strings through Jint's own JsonParser/JsonSerializer.
         Trade-off: first-party IL2026 is suppressed too. Mitigation: all first-party JSON goes through
         the source-generated KnockBoxProtocolContext (Serialization/), and the other AOT codes
         (IL3050 dynamic-code, IL2087/IL2075 reflection, …) still fail the gate. -->
    <NoWarn>$(NoWarn);IL2104;IL2026;IL3053</NoWarn>
  </PropertyGroup>

  <!-- Bake the platform shell + SDK into the publish output (web/ next to the binary), so a
       published exe or container serves the shell with no repo checkout. Dev is unaffected
       (CopyToOutputDirectory=Never): `dotnet run` serves the live repo web/ via repo discovery.
       games/ is deliberately NOT published — it is external content (volume / next to the exe). -->
  <ItemGroup>
    <Content Include="..\web\**" Exclude="..\web\node_modules\**;..\web\__tests__\**;..\web\package.json;..\web\package-lock.json" LinkBase="web" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- GC footprint knobs (see the GC comment above). Written into runtimeconfig.json and embedded by
       ILC for the AOT publish. System.GC.HeapCount is DECIMAL here (unlike the DOTNET_GCHeapCount env
       var, which is hex). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" Trim="false" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="2" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <!-- Direct override of Microsoft.AspNetCore.OpenApi's transitive Microsoft.OpenApi 2.0.0, which
         has a known vulnerability (GHSA-v5pm-xwqc-g5wc, circular schema refs; patched in 2.7.5).
         The NU1903 audit warning it raises fails the aot CI job under /warnaserror. Drop this
         override once Microsoft.AspNetCore.OpenApi references a patched version itself. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- Jint is a pure-C# interpreter with an official Native AOT sample; rooting the assembly keeps
       the trimmer from removing interpreter internals reached only through JsValue dispatch. All
       interop stays on the no-reflection path (JsValue/ClrFunction only, AllowClr never enabled) —
       see Games/JsAuthorityRuntime.cs.

       Rooting makes ILC surface Jint's internal RequiresUnreferencedCode sites as per-site IL2026
       errors under /warnaserror. All four flagged paths are unreachable from our usage, verified
       4.11.0 (re-audit on upgrade):
         - Options.Apply → NamespaceReference (×2): CLR namespace loading; only runs when AllowClr
           is enabled, which it never is.
         - DefaultTypeConverter.BuildDelegate: expression-tree marshaling for typed .NET delegates
           passed into the engine; we pass only ClrFunction/JsValue (JsCallDelegate), never typed
           delegates.
         - DefaultObjectConverter.ConvertSystemTextJsonValue: JsonNode → JsValue conversion; our
           boundary is strings through Jint's own JsonParser/JsonSerializer, JsonNode never crosses.
       TrimmerSingleWarn collapses them to the per-assembly roll-ups (IL2104/IL3053), which are
       suppressed above — first-party code keeps full per-site diagnostics. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Jint" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnockBox.Contracts\KnockBox.Contracts.csproj" />
  </ItemGroup>

  <!-- Let the test project exercise internal helpers (e.g. WebSocketHandler.CleanLogText) directly,
       without widening their public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="KnockBox.Server.Tests" />
  </ItemGroup>

</Project>
