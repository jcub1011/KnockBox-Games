{
  // Log levels are NOT configured here: Serilog is the host logger and sets them in code (see
  // Program.cs), deliberately avoiding ReadFrom.Configuration because its assembly scanning isn't
  // Native-AOT-safe. A "Logging" section in this file would be silently ignored.
  "KnockBox": {
    "LogRetentionDays": 31
  },
  "AllowedHosts": "*"
}
