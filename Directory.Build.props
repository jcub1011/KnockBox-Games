<Project>

  <!-- NuGet versions are pinned exact in each csproj (no floating majors, no lock files).
       A new package version arrives only via an explicit version bump. The SDK itself
       floats (see global.json `latestFeature`); SDK-implicit packages and compiler
       output are therefore not pinned — deterministic AOT output is explicitly not a goal. -->
  <PropertyGroup>
    <!-- The two RIDs the release ships (linux-x64 container + win-x64 desktop). -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
