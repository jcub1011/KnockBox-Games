# Copy this file to `.env` (next to docker-compose.yml) and adjust the paths.
# `.env` is gitignored; this template is tracked. Every setting below is optional.

# Stable host path for your game library. Mounted READ-ONLY — the server never writes here.
# Survives image updates and container recreation. Copy `.kbg` game packages (or plain game folders)
# in to publish them; either way they appear within seconds, with no restart.
KNOCKBOX_GAMES_DIR=/srv/knockbox/games

# Persistent location for the pre-compressed asset cache (.br/.gz variants, built at max effort).
# Leave this UNSET to use the Docker-managed `knockbox-compressed` named volume (recommended for a
# plain `docker compose` host — zero setup, correct ownership). Set it to a host path to keep the
# cache on a chosen disk/dataset instead — e.g. on TrueNAS:
#   KNOCKBOX_COMPRESSED_DIR=/mnt/tank/knockbox/games-compressed
# A host path must be WRITABLE by the container's non-root user (UID 1654), e.g.
#   chown -R 1654 /mnt/tank/knockbox/games-compressed
# Otherwise the server can't write the cache and silently falls back to slower on-the-fly compression.
#KNOCKBOX_COMPRESSED_DIR=/srv/knockbox/games-compressed

# Persistent location for games extracted from `.kbg` packages. Same rules as the cache above: leave
# UNSET to use the Docker-managed `knockbox-unpacked` named volume, or point it at a host path that is
# writable by UID 1654. Persisting it means a large library isn't re-extracted on every container
# recreation. If this location isn't writable, `.kbg` packages can't be installed at all and the home
# page shows a configuration warning saying so (plain game FOLDERS keep working regardless).
#KNOCKBOX_UNPACKED_DIR=/srv/knockbox/games-unpacked

# Persistent location for ALL admin state: the portal password hash (`admin.secret`) AND the operator
# policy file (`admin-settings.json`) — which games are disabled or staged, maintenance mode, runtime
# limit overrides, the banned room codes, the live announcement, registered marketplaces, update
# enrolments and webhook endpoints. Leave UNSET to use the Docker-managed `knockbox-admin` named
# volume, or point it at a host path writable by UID 1654.
# UNLIKE the two directories above this is NOT a regenerable cache. Lose it and the portal reverts to
# UNCLAIMED *and* every policy decision is forgotten — a game you disabled starts serving players
# again. This is the single most important thing to back up. (Deleting just `admin.secret` is the
# intended password-reset path, and leaves your policy intact.)
#KNOCKBOX_ADMIN_DIR=/srv/knockbox/admin

# Persistent location for the game packages the ADMIN PORTAL installed — downloaded from a marketplace
# or uploaded by hand — plus the previous versions kept for one-click rollback. Leave UNSET to use the
# Docker-managed `knockbox-managed` named volume, or a host path writable by UID 1654.
# Also NOT regenerable: a marketplace game can be downloaded again, but one you UPLOADED exists
# nowhere else. Note these games are NOT in KNOCKBOX_GAMES_DIR (that mount is read-only), so backing
# up your games dir alone does not capture your whole library. Never share it between instances —
# each server reconciles and prunes its own copy.
#KNOCKBOX_MANAGED_DIR=/srv/knockbox/games-managed

# Where the daily rolling log files go. Leave UNSET and logs stay INSIDE the container, so they are
# discarded every time you update the image — fine for casual use, but KnockBox__LogRetentionDays
# (default 31) cannot actually keep 31 days of history unless this is mounted. The compose file ships
# this mount commented out, so uncomment it there as well as setting this.
#KNOCKBOX_LOGS_DIR=/srv/knockbox/logs
